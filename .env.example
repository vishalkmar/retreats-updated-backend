# Server
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=retreats_traveon
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin (seeded on first run)
ADMIN_EMAIL=admin@traveon.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Super Admin

# Upload (legacy, kept for backward-compat — new uploads use Cloudinary)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# Cloudinary (uploads now go here, not to local disk)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=traveon-retreats
